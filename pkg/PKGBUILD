# Maintainer: Ryan <ryan@heyoodle.com>

pkgname=omareel
pkgver=0.1.0
pkgrel=1
pkgdesc='Polished screen recorder and editor for Omarchy'
arch=('x86_64')
url='https://github.com/heyoodle/omareel'
license=('MIT')
depends=('gpu-screen-recorder' 'ffmpeg' 'slurp' 'qt6-base' 'qt6-declarative'
         'qt6-multimedia' 'qt6-svg' 'layer-shell-qt' 'libevdev' 'xdg-desktop-portal')
optdepends=('gifsicle: optimize exported GIF files')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
conflicts=('omarecord')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omareel "$pkgdir/usr/bin/omareel"
  ln -s omareel "$pkgdir/usr/bin/omarecord"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/omareel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omareel.svg"
  local size
  for size in 16 32 48 64 128 256; do
    /usr/bin/install -Dm644 "$startdir/icons/omareel-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omareel.png"
  done
  /usr/bin/install -Dm644 "$startdir/omareel.desktop" "$pkgdir/usr/share/applications/omareel.desktop"
}
