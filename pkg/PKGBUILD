# Maintainer: Ryan <ryan@heyoodle.com>

pkgname=omarecord
pkgver=0.1.0
pkgrel=1
pkgdesc='Polished screen recorder and editor for Omarchy'
arch=('x86_64')
url='https://github.com/heyoodle/omarecord'
license=('MIT')
depends=('gpu-screen-recorder' 'ffmpeg' 'slurp' 'qt6-base' 'qt6-declarative'
         'qt6-multimedia' 'qt6-svg' 'layer-shell-qt' 'libevdev' 'xdg-desktop-portal')
optdepends=('gifsicle: optimize exported GIF files')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omarecord "$pkgdir/usr/bin/omarecord"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/omarecord.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarecord.svg"
  /usr/bin/install -Dm644 "$startdir/omarecord.desktop" "$pkgdir/usr/share/applications/omarecord.desktop"
}
