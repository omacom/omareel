#!/bin/sh
# Stand-in for slurp while the oracle runs (tests/golden/README.md, "Replayed programs"): with
# OMAREEL_ORACLE_REPLAY_DIR set it answers from there (see replay.sh); otherwise it refuses, so
# nothing reaches the real program.
if [ -z "${OMAREEL_ORACLE_REPLAY_DIR+set}" ]; then
    echo "slurp shim: unexpected call: $*" >&2
    exit 64
fi
. "$(dirname "$(readlink -f "$0")")/replay.sh"
replay slurp "$@"
